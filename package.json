{
  "name": "automation-playwright-script",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "drs:setup": "playwright test --project=drs tests/drs/setup --workers=1",
    "drs:setup:dev": "cross-env DRS_ENV=dev playwright test --project=drs tests/drs/setup --workers=1",
    "drs:catalog": "playwright test --project=drs-setting tests/drs-setting --workers=1",
    "onboarding": "node tests/utils/run-onboarding.js",
    "onboarding:uat": "cross-env DRS_ENV=uat PULSE_ENV=uat node tests/utils/run-onboarding.js",
    "drs:explore": "playwright test --project=drs tests/drs/inspection --workers=1",
    "integration": "playwright test --project=integration tests/integration --workers=1",
    "integration:uat": "cross-env PULSE_ENV=uat DRS_ENV=uat playwright test --project=integration tests/integration --workers=1",
    "integration:smoke": "playwright test --project=smoke-drs-* --workers=1",
    "integration:smoke:uat": "cross-env PULSE_ENV=uat DRS_ENV=uat playwright test --project=smoke-drs-* --workers=1",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "reset:rfi-tracker": "node tests/utils/reset-tracker.js",
    "reset:nc-tracker": "node tests/utils/reset-nc-tracker.js",
    "smoke:status": "node tests/utils/print-smoke-trackers.js",
    "smoke:status:json": "node tests/utils/print-smoke-trackers.js --json",
    "smoke:full": "node tests/utils/run-smoke.js solar",
    "smoke:full:artifacts": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=smoke-reports/results.json PLAYWRIGHT_JUNIT_OUTPUT_NAME=smoke-reports/junit.xml node tests/utils/run-smoke.js solar -- --reporter=list,html,json,junit",
    "smoke:full:qa": "cross-env PULSE_ENV=qa npm run smoke:full:artifacts",
    "smoke:full:test": "cross-env PULSE_ENV=test npm run smoke:full:artifacts",
    "smoke:full:qa:reset": "cross-env PULSE_ENV=qa SMOKE_RESET=1 npm run smoke:full:artifacts",
    "smoke:full:test:reset": "cross-env PULSE_ENV=test SMOKE_RESET=1 npm run smoke:full:artifacts",
    "smoke:full:reuse": "cross-env SMOKE_USERS=reuse node tests/utils/run-smoke.js solar",
    "smoke:full:reset": "cross-env SMOKE_RESET=1 node tests/utils/run-smoke.js solar",
    "smoke:full:retry": "cross-env SMOKE_RETRY_FAILED=1 node tests/utils/run-smoke.js solar",
    "smoke:lanes": "node tests/utils/run-smoke-lanes.js solar",
    "smoke:lanes:plan": "node tests/utils/run-smoke-lanes.js solar --plan",
    "smoke:lanes:qa": "cross-env PULSE_ENV=qa node tests/utils/run-smoke-lanes.js solar",
    "smoke:lanes:test": "cross-env PULSE_ENV=test node tests/utils/run-smoke-lanes.js solar",
    "smoke:lanes:reset": "cross-env SMOKE_RESET=1 node tests/utils/run-smoke-lanes.js solar",
    "smoke:wind": "node tests/utils/run-smoke.js wind",
    "smoke:restore": "playwright test --workers=1 --project=smoke-solar-restore",
    "smoke:list": "node tests/utils/run-smoke.js solar --list",
    "smoke:solar": "node tests/utils/run-smoke.js solar",
    "smoke:solar:artifacts": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=smoke-reports/results.json PLAYWRIGHT_JUNIT_OUTPUT_NAME=smoke-reports/junit.xml node tests/utils/run-smoke.js solar -- --reporter=list,html,json,junit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  }
}
