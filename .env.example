# ============================================================================
# DRS -> PULSE INTEGRATION  (docs/drs-pulse-integration.md)
# ============================================================================
# Keys (real values go in .env only, never here):
# DRS_SUPER_ADMIN_EMAIL=
# DRS_SUPER_ADMIN_PASSWORD=
# DRS_ENV=uat                     # uat (pairs with pulse-uat) | dev (pairs with pulse-qa/dev/test)
# DRS_BASE_URL=                   # optional override of the DRS URL for DRS_ENV
# DRS_WORK_AREAS=13               # Work Areas D02 imports (default 2; smoke-drs-* needs 13)
# DRS_SECTIONS_PER_AREA=300       # Work Sections per Work Area (default 300)
# DRS_PROJECT_TAG=26092026-FQQ    # optional: pin integration/smoke-drs to an older DRS project

# URLs live in .env (edit them there - no command change needed). One set per DRS_ENV:
# DRS_UAT_URL=https://drs-uat.cfapps.ap11.hana.ondemand.com
# DRS_UAT_USER_MANAGEMENT_URL=https://auth-mgmt-uat.cfapps.ap11.hana.ondemand.com   # Vendor Management lives here since 2026-10-01 (own login)
# DRS_DEV_URL=https://drs-dev.cfapps.ap11.hana.ondemand.com
# DRS_DEV_USER_MANAGEMENT_URL=https://auth-mgmt-dev.cfapps.ap11.hana.ondemand.com   # assumed, not yet verified
# DRS_ENV picks the set; the Pulse side of the integration suites comes from PULSE_ENV / BASE_URL in .env as for every other suite.
# `npm run drs:setup`, `npm run integration` and `npm run integration:smoke` read all of this from .env;
# the :uat / :dev variants pin their environment on the command line instead.

# !! `npm run drs:setup` runs EVERY stage, and D02 starts a NEW (permanent) DRS project unless one is
# !! still missing D5 - so do NOT re-run it to retry a later stage. Retry a single stage with npx and
# !! the spec file(s) by name, which resumes the newest unfinished project and creates nothing new:
# npx playwright test --project=drs tests/drs/setup/D03_pin_catalog_version.spec.js tests/drs/setup/D04_service_order.spec.js --workers=1

# --- 1. DRS setup suite (tests/drs/setup, D01 -> D06, one worker) ---
# New project each run; an unfinished project is resumed instead.
# npm run drs:setup                                   # drs-uat
# npm run drs:setup:dev                               # drs-dev
# $env:DRS_WORK_AREAS="13"; npm run drs:setup         # 13-Work-Area tree for the full smoke-drs chain
# DRS_WORK_AREAS=13 npm run drs:setup                 # same, Git Bash

# One stage only (run them in order):
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D01_masters.spec.js --workers=1              # vendor, SPV, site (find-or-create once)
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D02_project_and_tree.spec.js --workers=1     # project + Work Location CSV import
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D03_pin_catalog_version.spec.js --workers=1  # pin catalog v1 per Work Area (cannot be undone)
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D04_service_order.spec.js --workers=1        # Service Order + vendor details
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D05_so_configuration.spec.js --workers=1     # SO configuration (Piling x BL)
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/setup/D06_so_line_mapping.spec.js --workers=1      # SO line mapping (WMC only, optional)
# Add --headed to watch any of them.

# THEN WAIT for the DRS -> Pulse sync (5-20 min): the project/Work Location shows in Pulse admin dashboard filter.

# --- 2. DRS exploration (read-only, writes blocked) ---
# npx cross-env DRS_ENV=uat playwright test --project=drs tests/drs/inspection --workers=1

# --- 3. Pulse on the DRS project (after sync) ---
# npm run integration:uat                             # IN01-IN14 (users, WAM, RFI/NC cycles + matrices, feature specs)
# npx cross-env PULSE_ENV=uat DRS_ENV=uat playwright test --project=integration tests/integration/IN05_rfi_matrix.spec.js --workers=1    # one wrapper
# npm run integration:smoke:uat                       # full smoke chain on DRS ground (smoke-drs-*, ~2 h, needs 13 Work Areas)
# $env:SMOKE_RESET="1"; npm run integration:smoke:uat # same, trackers reset to seed first

# npx cross-env PULSE_ENV=uat DRS_ENV=uat playwright test --project=integration tests/integration/IN01_users.spec.js tests/integration/IN02_wam.spec.js --workers=1


# --- List without running ---
# npx cross-env DRS_ENV=uat playwright test --project=drs --list
# npx cross-env PULSE_ENV=uat DRS_ENV=uat playwright test --project=integration --list




# ============================================================================
# REASSIGNMENT SUITE  (docs/reassignment-scenarios.md, section 3j)
# ============================================================================
# Specs live in tests/specs/ (40-55 plus 11). They are NOT Playwright project
# dependencies, so any spec can be run alone. What they share is DATA:
#   * the FLEET   (spec 40 -> tests/fixtures/reassign-fleet.json, keyed per env)
#   * the RECORD POOL (specs 42 RFI + 43 NC -> tests/fixtures/reassign-records.json)
# Run ONE command at a time, never two in parallel (shared users + WAM).
# Pick the deployment first:
# $env:PULSE_ENV="test"                               # PowerShell
# PULSE_ENV=test                                      # Git Bash (prefix each command)

# --- 0. Before anything: does the ground still exist? (read-only) ---
# npx playwright test tests/specs/inspection/00_inspect_reassign_fleet_users_exist.spec.js --project=chromium --workers=1   # are all 18 fleet accounts still there?
# npx playwright test tests/specs/inspection/00_inspect_reassign_bl07_work_sections.spec.js --project=chromium --workers=1 # free Work Sections on A-06c/BL07 (INSPECT_SUBPACKAGE="Piling" to narrow)
# npx playwright test tests/specs/inspection/00_inspect_reassign_fleet_wam.spec.js --project=chromium --workers=1           # is every fleet member still mapped? prints the REMAP command if not

# --- 1. SETUP (fresh deployment, or after a data clear) ---
# Fleet: 18 users + WAM. Idempotent; recorded members are skipped.
# $env:REASSIGN_FLEET_GROUP="all"; npx playwright test tests/specs/40_reassign_fleet_setup.spec.js --project=chromium --workers=1
# Re-apply WAM only for named members (what the fleet-WAM check tells you to run):
# $env:REASSIGN_FLEET_GROUP="all"; $env:REASSIGN_FLEET_REMAP="CI_C,CI_D,CI_E,EE_D,QI_D"; npx playwright test tests/specs/40_reassign_fleet_setup.spec.js --project=chromium --workers=1
# Record pool. RFIs FIRST, then NCs (a non-approved NC blocks RFI create on the same ground).
# Each RFI permanently consumes a Work Section on BL07 - 42 raises 16.
# npx playwright test tests/specs/42_reassign_rfi_records_setup.spec.js --project=chromium --workers=1
# npx playwright test tests/specs/43_reassign_nc_records_setup.spec.js --project=chromium --workers=1
# A SECOND full run needs a fresh pool. REASSIGN_POOL_RESET=1 makes 42 (and only 42) clear
# THIS deployment's rfi + nc entries in tests/fixtures/reassign-records.json first, i.e. set
# environments.<PULSE_ENV> to {"rfi":{},"nc":{}}. Other deployments' entries are untouched.
# Check BL07 still has free Work Sections first (section 0) - the reset clears the file, not the app.
# Clear the variable afterwards, or the next 42 run wipes the pool again:
# $env:REASSIGN_POOL_RESET="1"; npx playwright test tests/specs/42_reassign_rfi_records_setup.spec.js --project=chromium --workers=1; Remove-Item Env:REASSIGN_POOL_RESET
# npx playwright test tests/specs/43_reassign_nc_records_setup.spec.js --project=chromium --workers=1   # then NCs, as above (no reset here)

# --- 2. READ-ONLY / safe to repeat (use no record) ---
# npx playwright test tests/specs/41_reassign_eligibility.spec.js --project=chromium --workers=1      # Family E: who appears in "Assign to"
# npx playwright test tests/specs/44_reassign_permissions.spec.js --project=chromium --workers=1      # Family R: what each role may reassign (PM test.fail() = the known defect)

# --- 3. BEHAVIOUR specs (each MUTATES its own pool record - one run per pool) ---
# npx playwright test tests/specs/45_reassign_capability.spec.js --project=chromium --workers=1        # C: reassigned record can still be worked
# npx playwright test tests/specs/46_reassign_handoff_integrity.spec.js --project=chromium --workers=1 # H/I/X/B: hand-off both ways, version + code unchanged
# npx playwright test tests/specs/47_reassign_wam_snapshot.spec.js --project=chromium --workers=1      # S: WAM remap vs in-flight record (rewrites WAM, restores in afterAll)
# npx playwright test tests/specs/48_reassign_nc.spec.js --project=chromium --workers=1                # NC side
# npx playwright test tests/specs/49_reassign_demap_hazard.spec.js --project=chromium --workers=1      # S3: clear BL07's CI (restores) - reuses 47's S_SNAPSHOT, so run AFTER 47
# npx playwright test tests/specs/50_reassign_future_past_actor.spec.js --project=chromium --workers=1 # H2/H3 (~10 min)
# npx playwright test tests/specs/51_reassign_content_and_linked_nc.spec.js --project=chromium --workers=1 # I2/I4 (~8 min)
# npx playwright test tests/specs/52_reassign_closed_nc.spec.js --project=chromium --workers=1         # B2: closed NC has no reassign control
# npx playwright test tests/specs/53_reassign_capability_more.spec.js --project=chromium --workers=1   # C4/C6 (~10 min)
# npx playwright test tests/specs/54_reassign_snapshot_ee_qi.spec.js --project=chromium --workers=1    # S5: EE + QI remap (restores)
# npx playwright test tests/specs/55_reassign_demap_user_everywhere.spec.js --project=chromium --workers=1 # record's own CI demapped everywhere (restores)
# Spec 11 LAST: it reassigns the FIRST pending RFI and NC to the first eligible person (a real user).
# npx playwright test tests/specs/11_reassign_rfi_nc.spec.js --project=chromium --workers=1

# --- 4. WHOLE SUITE in one command (~1.5-2 h; assumes fleet + pool are built). Files run alphabetically, so 47 precedes 49. ---
# npx playwright test tests/specs/41_reassign_eligibility.spec.js tests/specs/44_reassign_permissions.spec.js tests/specs/45_reassign_capability.spec.js tests/specs/46_reassign_handoff_integrity.spec.js tests/specs/47_reassign_wam_snapshot.spec.js tests/specs/48_reassign_nc.spec.js tests/specs/49_reassign_demap_hazard.spec.js tests/specs/50_reassign_future_past_actor.spec.js tests/specs/51_reassign_content_and_linked_nc.spec.js tests/specs/52_reassign_closed_nc.spec.js tests/specs/53_reassign_capability_more.spec.js tests/specs/54_reassign_snapshot_ee_qi.spec.js tests/specs/55_reassign_demap_user_everywhere.spec.js tests/specs/11_reassign_rfi_nc.spec.js --project=chromium --workers=1
# Run the fleet-WAM check (section 0) before and after the WAM-changing specs: 47, 49, 54, 55.

# --- Add --headed to watch any of them. Add --reporter=list for plain output. ---

# $env:PULSE_ENV="test"
# $env:REASSIGN_POOL_RESET="1"; npx playwright test tests/specs/42_reassign_rfi_records_setup.spec.js --project=chromium --workers=1; Remove-Item Env:REASSIGN_POOL_RESET
# npx playwright test tests/specs/43_reassign_nc_records_setup.spec.js --project=chromium --workers=1

# ============================================================================
# DRS SETTING -> PACKAGE CONFIGURATOR  (tests/drs-setting/README.md)
# ============================================================================
# npm run drs:catalog                              # PC_MODE=verify (default): READ-ONLY check of the runbook tree
# PC_MODE=verify|build                             # build creates nodes on a DRAFT (never Lock/Reset/Discard/Delete)
# PC_RUNS=2                                        # matrix rows to run (1=All sites P,Q  2=Khavda R,S  3=Mandvi T,U); default all
# PC_SITE=Khavda  PC_LETTERS=V,W                   # one custom run - use FRESH codes, P..U are taken
# PC_LETTERS=AB,CD                                 # 1-3 capital letters; two-letter codes cannot clash with the existing single-letter packages
# PC_LETTERS=auto                                  # build only: picks two UNUSED two-letter codes from the live tree
# $env:PC_SITE="Khavda"; $env:PC_LETTERS="V,W"; $env:PC_MODE="build"; npm run drs:catalog
